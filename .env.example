APP_NAME=CarbonTrace
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-local-password
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg://carbontrace:carbontrace@localhost:5432/carbontrace
CELERY_BROKER_URL=redis://localhost:6379/0
RUN_JOBS_ASYNC=false
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIRECTORY=./uploads
REPORT_DIRECTORY=./generated_reports
OWID_DATA_URL=https://owid-public.owid.io/data/co2/owid-co2-data.csv
OWID_DATA_DIRECTORY=./data/owid
LLM_PROVIDER=disabled
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
CHROMA_HOST=localhost
CHROMA_PORT=8001
